<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= config.brandName %></title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="hero">
    <h1><%= config.brandName %></h1>
    <p>Instant, secure checkout</p>
  </header>

  <main class="container">
    <% if (error) { %>
      <div class="alert error"><%= error %></div>
    <% } %>

    <form action="/checkout" method="POST" class="order-form">
      <label>
        Email
        <input type="email" name="email" required placeholder="you@example.com" />
      </label>

      <label>
        Amount (USD)
        <input type="number" name="amount" step="0.01" min="0.50" max="100000" required placeholder="e.g. 10.00" />
      </label>

      <button type="submit">Pay with CashTap</button>
    </form>

    <p class="fineprint">Minimum $0.50. You'll be redirected to CashTap's secure checkout to complete payment.</p>
  </main>
</body>
</html>
