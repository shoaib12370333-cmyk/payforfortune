# Your CashTap secret key from Developers -> API Settings (sk_live_...)
CASHTAP_SECRET_KEY=

# Signing secret for the webhook endpoint you create under Developers -> Webhooks (whsec_...)
CASHTAP_WEBHOOK_SECRET=

# Public URL this app is deployed at (used to build success/cancel redirect URLs)
BASE_URL=http://localhost:3000

# Admin panel login (Basic Auth) — change these before deploying
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

PORT=3000
